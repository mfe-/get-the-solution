{
  "name": "get-the-solution-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:prerender-routes": "node scripts/generate-prerender-routes.js",
    "convert:blog-markdown": "for i in src/assets/database/*.md; do pandoc \"$i\" -o \"${i%.*}.html\" --highlight-style=breezeDark --verbose; done",
    "start": "node scripts/start.js",
    "prebuild": "npm run generate:prerender-routes && npm run convert:blog-markdown",
    "build": "ng build",
    "watch": "npm run generate:prerender-routes && npm run convert:blog-markdown && ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:get-the-solution-app": "node dist/get-the-solution-app/server/server.mjs"
  },
  "overrides": {
    "vite": "^8.3.5"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.4",
    "express": "^4.21.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "~22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^22.10.5",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "^6.0.3"
  }
}